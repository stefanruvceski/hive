{
  "name": "hive",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@tanstack/react-query": "^5.105.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.21",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "expo-doctor": "1.21.5",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm docs:check",
    "docs:check": "node scripts/check-agent-docs.mjs",
    "new:module": "node scripts/new-module.mjs",
    "new:screen": "node scripts/new-screen.mjs",
    "lint": "expo lint --max-warnings 0",
    "lint:fix": "expo lint --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test .maestro",
    "doctor:expo": "expo-doctor",
    "doctor:ci": "node scripts/doctor-ci.mjs",
    "deps:check": "expo install --check",
    "db:generate": "drizzle-kit generate",
    "build:dev:ios": "eas build --profile development-simulator --platform ios --local",
    "build:dev:android": "eas build --profile development --platform android --local",
    "build:preview": "eas build --profile preview --platform all",
    "update:preview": "eas update --channel preview --auto",
    "prepare": "husky"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.maestro/",
      "/.claude/worktrees/"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/__mocks__/style-mock.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/types/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 50,
        "branches": 49,
        "functions": 40,
        "lines": 50
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12"
  }
}
